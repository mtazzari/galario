# I don't understand why I have to import numpy here even it was already
# imported in the file including this one...
import numpy as np

ctypedef ${GALARIO_REAL_TYPE} dreal
real_dtype = np.${GALARIO_REAL_DTYPE}

ctypedef ${GALARIO_COMPLEX_TYPE} dcomplex
complex_dtype = np.${GALARIO_COMPLEX_DTYPE}
complex_typenum = np.${GALARIO_COMPLEX_TYPENUM}
